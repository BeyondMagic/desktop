type = process
command = /usr/bin/env UV_CACHE_DIR=/usr/lib/byparr/.uv-cache HOST=0.0.0.0 PORT=8191 /usr/bin/uv run main.py
# Environment="PROXY_SERVER=" "PROXY_USERNAME=" "PROXY_PASSWORD="
working-dir = /usr/lib/byparr/
run-as = byparr
smooth-recovery = true
logfile = /var/log/dinit/byparr.log
depends-on = tailscaled
